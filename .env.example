# Telegram Bot Token (получить у @BotFather)
BOT_TOKEN=your_telegram_bot_token_here

# Админы (Telegram user ID через запятую)
ADMIN_IDS=123456789

# GigaChat (Sber)
GIGACHAT_CREDENTIALS=your_gigachat_credentials_here
GIGACHAT_MODEL=GigaChat-2
# SSL verification (default: true). Set to false ONLY for local self-signed testing.
GIGACHAT_VERIFY_SSL_CERTS=true

# SQLite
DATABASE_DIR=./database
DATABASE_NAME=bot.db

# Logging
LOG_LEVEL=INFO
LOG_FILE=bot.log

# Индикатор загрузки экзаменатора: short_name пака стикеров (без ссылки) и эмодзи стикера
# Например пак https://t.me/addstickers/mikey_bear_vk_by_TgEmojiBot -> mikey_bear_vk_by_TgEmojiBot
LOADING_STICKER_PACK=
LOADING_STICKER_EMOJI=😐
